
{
  "name": "dramatv-desktop",
  "version": "1.0.0",
  "description": "DramaTV Desktop for Windows 10 and 11",
  "main": "src/main.js",
  "author": "DramaTV Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "35.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.dramatv.desktop",
    "productName": "DramaTV",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "DramaTV(1).ico"
    ],
    "win": {
      "icon": "DramaTV(1).ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
